{
  "schema": "https://structuredmerge.org/schemas/diagnostic-fixture/v1.json",
  "slice": "805",
  "name": "fallback-scopes",
  "description": "Fallback scopes are runtime/reporting vocabulary for choosing the smallest coherent region that can safely fall back.",
  "fallback": {
    "report_id": "fallback-scopes-runtime-report",
    "version": "1",
    "scopes": [
      {
        "scope": "node",
        "path": "/declarations/Greet/body/0",
        "owner_path": "/declarations/Greet",
        "covers_children": false,
        "requires_source_span": true,
        "description": "fallback only the selected node"
      },
      {
        "scope": "subtree",
        "path": "/declarations/Greet",
        "owner_path": "/declarations/Greet",
        "covers_children": true,
        "requires_source_span": true,
        "description": "fallback the selected node and descendants"
      },
      {
        "scope": "owned_region",
        "path": "/declarations/Greet",
        "owner_path": "/declarations/Greet",
        "covers_children": true,
        "requires_source_span": true,
