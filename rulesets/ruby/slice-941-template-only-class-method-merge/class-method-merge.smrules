# fixture ruby/slice-941-template-only-class-method-merge/class-method-merge.json
format ruby
owners class_body_methods
match method_name
read native_read_portable_write
attach normalize_tracked_layout_merge
comment_style hash_comment
render ruby_declarations
surface method stable_signature
capability recursive_declaration_merge true
capability destination_method_body_wins true
capability template_missing_method_adds true
