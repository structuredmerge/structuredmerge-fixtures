  "name": "rust-kernel-provider-traits",
  "description": "Object-safe Rust traits support heterogeneous in-process and Alef host providers while preserving TreeHaver-only parser selection.",
  "audited_revisions": {
    "structuredmerge_rust": "7903b6f440e8861410b1b64103db269ef78bf234",
    "alef": "eebd7619b9c8217b16d2ee9b287738ce6c97dda9",
    "tree_sitter_language_pack": "8f59a4bb1a372ac5f2aead6b8ff01bb63b1a2964"
  },
  "audit_findings": [
    {
      "id": "rust.generic-parser-adapter",
      "repository": "structuredmerge_rust",
      "finding": "ParserAdapter<TAnalysis> is generic and cannot directly populate a heterogeneous runtime provider registry",
      "disposition": "replace_with_object_safe_owned_envelope_trait"
    },
    {
      "id": "rust.reference-only-registry",
      "repository": "structuredmerge_rust",
      "finding": "the backend registry stores BackendReference values rather than parser implementations and immutable capability snapshots",
      "disposition": "replace_with_provider_registry_snapshots"
    },
    {
      "id": "rust.legacy-normalized-shape",
      "repository": "structuredmerge_rust",
      "finding": "legacy normalized nodes duplicate source fragments and do not implement the Slice 1024 child-edge and extension contract",
      "disposition": "migrate_to_slice_1024_owned_values"
    },
    {
      "id": "tslp.outbound-only-ir",
      "repository": "tree_sitter_language_pack",
      "finding": "the current Alef IR exports owned types/functions but zero traits, services, and handler contracts",
      "disposition": "do_not_assume_tslp_generation_proves_host_provider_bridges"
    },
    {
      "id": "alef.callback-versus-trait-bridge",
      "repository": "alef",
      "finding": "Alef has dedicated trait-bridge generators while the generic callback adapter still contains unsupported host conversions for some runtimes",
      "disposition": "prototype_actual_magnus_trait_bridge_before_fixing_abi"
    }
  ],
