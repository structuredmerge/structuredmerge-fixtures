  "decision": "Keep the old plugin registration vocabulary, but attach it to the active recipe-pack runner only at apply-time after_phase(:remaining_files). Do not port old phase objects.",
  "loader_contract": {
    "registration_method": "register_kettle_jem_plugin",
    "name_normalization": [
      "array/string input is flattened",
      "blank names are ignored",
      "duplicates are removed"
    ],
    "require_path": "dashed plugin names become slash-separated require paths",
    "constant_resolution": "dashed plugin names become CamelCase namespace paths"
  },
  "registrar_contract": {
    "methods": [
      "before_phase",
      "after_phase",
      "on_phase"
    ],
    "timings": [
      "before",
      "after"
    ],
    "blank_phase": "error",
    "unsupported_timing": "error",
    "callback_without_block": "error"
  },
  "active_runner_contract": {
    "plan": {
      "loads_plugins": true,
      "reports_plugin_load_errors": true,
      "runs_callbacks": false,
      "mutates_files": false
    },
    "apply": {
      "loads_plugins": true,
      "reports_plugin_load_errors": true,
      "runs_callbacks": [
        {
          "timing": "after",
          "phase": "remaining_files"
        }
      ],
      "records_plugin_file_changes": true,
      "appends_plugin_diagnostics": true
    }
  },
  "context_contract": {
    "fields": [
      "project_root",
      "mode",
      "facts",
      "recipe_pack",
      "recipe_reports",
      "changed_files",
      "diagnostics",
      "helpers",
      "out"
    ],
    "helpers": [
