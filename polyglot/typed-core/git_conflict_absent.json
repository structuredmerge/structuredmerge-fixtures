{
  "id": "git_conflict_absent",
  "category": "git_common_merge3",
  "call": "git_common_merge3",
  "description": "Deleted ours owner remains unresolved with an empty-side appended review block, not merged output",
  "input": {
    "dialect": "json",
    "base": "{\"x\":0}",
    "ours": "{}",
    "theirs": "{\"x\":2}",
    "marker_size": 7,
    "ours_label": "ours"
  },
  "assertions": [
    {
      "type": "equals",
      "field": "ok",
      "value": false
    },
    {
      "type": "equals",
      "field": "output",
      "value": null
    },
    {
      "type": "equals",
      "field": "conflicted_output",
      "value": "{}\n<<<<<<< ours\n||||||| base\n{\"x\":0}\n=======\n{\"x\":2}\n>>>>>>> theirs\n"
    },
    {
      "type": "count_equals",
      "field": "conflicts",
      "value": 1
    },
    {
      "type": "contains",
      "field": "render_report[strategy]",
      "value": "git-absent-owner-conflict-review"
    }
  ]
}
