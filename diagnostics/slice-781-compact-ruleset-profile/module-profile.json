{
  "ruleset_path": [
    "rulesets",
    "go",
    "slice-780-profile-vocabulary",
    "module-profile.smrules"
  ],
  "profile": {
    "format": "go",
    "owners": "top_level_declarations",
    "match": "structural_signature",
    "read": "native_read_portable_write",
    "attach": "normalize_tracked_layout_merge",
    "comment_style": "c_style_line",
    "render": "go_declarations",
    "render_strategy": "source_fragment_reuse",
    "backends": [
      {
        "backend": "go-dst",
        "support": "supported"
      },
      {
        "backend": "go-parser",
        "support": "supported"
      },
      {
        "backend": "kreuzberg-language-pack",
        "support": "supported"
      }
    ],
    "node_roles": [
      {
        "selector": "import_declaration",
        "role": "structural"
      },
      {
        "selector": "line_comment",
        "role": "comment"
      },
      {
        "selector": "semicolon",
        "role": "separator"
      }
    ],
    "atomic_nodes": [
      {
        "selector": "string_literal",
        "atomic": true
      },
      {
        "selector": "function_body",
        "atomic": false
      }
    ],
    "child_groups": [
      {
        "parent_selector": "source_file",
        "name": "imports",
        "policy": "unordered"
      },
      {
        "parent_selector": "source_file",
        "name": "declarations",
        "policy": "ordered"
      }
    ],
    "capabilities": [
      {
        "name": "imports_destination_wins",
        "value": "true"
      },
      {
        "name": "native_backend_parity",
        "value": "true"
      }
    ],
    "logical_owners": [],
    "repairs": [],
    "surfaces": [],
    "delegates": []
  }
}
