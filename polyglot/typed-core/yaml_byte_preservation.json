    "theirs": "\ufeff# header\r\né: 'one'  # stable\r\nbeta: theirs"
  },
  "assertions": [
    {"type": "equals", "field": "output", "value": "\ufeff# header\r\né: 'ours'  # stable\r\nbeta: theirs"},
