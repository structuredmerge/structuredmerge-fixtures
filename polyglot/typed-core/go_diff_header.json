    },
    {
      "type": "count_equals",
      "field": "changes",
      "value": 3
    },
    {
      "type": "equals",
      "field": "changes[0].classification",
      "value": "deleted"
    },
    {
      "type": "equals",
      "field": "changes[0].path",
      "value": "/package:main"
    },
    {
      "type": "equals",
      "field": "changes[1].classification",
      "value": "added"
    },
    {
      "type": "equals",
      "field": "changes[1].path",
      "value": "/package:other"
    },
    {
      "type": "equals",
      "field": "changes[2].subject_ref",
      "value": "document"
    }
  ]
