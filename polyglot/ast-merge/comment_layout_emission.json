{
  "id": "ast_merge_comment_layout_emission",
  "contract": "ast_merge_comment_layout_emission",
  "description": "Shared retained-owner leading segment line selection contract ported from Ruby ast-merge.",
  "cases": [
    {
      "name": "uses_output_owners_attached_leading_region_blank_prefix",
      "source_lines": ["alpha", "", "# shared", "", "beta"],
      "output_lines": ["alpha", "", "# shared", "", "beta"],
      "source_region_start_line": 3,
      "output_owner_start_line": 5,
      "target_leading_region_start_line": 3,
      "previous_owner_trailing_region_matches": false,
      "expected_line_numbers": [2, 3, 4]
    },
    {
      "name": "does_not_duplicate_previous_owner_trailing_region",
      "source_lines": ["alpha", "", "# shared", "beta"],
      "output_lines": ["alpha", "", "# shared", "beta"],
      "source_region_start_line": 3,
      "output_owner_start_line": 4,
      "target_leading_region_start_line": null,
      "previous_owner_trailing_region_matches": true,
      "expected_line_numbers": [3]
    },
    {
      "name": "uses_source_blank_prefix_when_output_has_no_attached_region",
      "source_lines": ["alpha", "", "", "# different", "beta"],
      "output_lines": ["alpha", "# other", "beta"],
      "source_region_start_line": 4,
      "output_owner_start_line": 3,
      "target_leading_region_start_line": null,
      "previous_owner_trailing_region_matches": false,
      "expected_line_numbers": [2]
    }
  ]
}
