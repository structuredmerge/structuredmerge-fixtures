  "contract_rules": [
    "comment regions are passive data and do not decide git or template merge outcomes",
    "layout gaps may be shared between adjacent owners but only one side controls output",
    "floating comments are positional and require layout ownership before a provider may emit them through a structural owner",
    "freeze markers are detected through the shared directive vocabulary but remain attached comment metadata until a merge policy consumes them",
    "provider-specific parser details belong in metadata and must not be required for generic merge behavior"
  ],
  "next_porting_targets": ["go", "rust", "typescript"],
  "expected": {
